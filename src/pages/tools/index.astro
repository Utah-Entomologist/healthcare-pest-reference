---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE_URL } from '../../lib/site';
import { ROWS, AUTHORITIES } from '../../data/complianceMap';
---

<BaseLayout
  title="Tools"
  description="Free working tools built from the Healthcare Pest Reference: a healthcare facility pest compliance map that prints as a survey-readiness checklist."
  breadcrumbs={[{ name: 'Tools', url: `${SITE_URL}/tools/` }]}
>
  <style>
    .tool { border-bottom: 1px solid var(--color-rule); padding: 1.25rem 0; }
    .tool h2 { margin: 0 0 0.4rem; font-size: 1.2rem; }
    .tool h2 a { color: var(--color-primary); }
    .tool p { margin: 0.3rem 0; max-width: 46rem; }
  </style>

  <h1>Tools</h1>
  <p>Built from the same primary sources as the authority and deficiency pages. Free to use.</p>

  <div class="tool">
    <h2><a href="/tools/compliance-map/">Pest Compliance Map</a></h2>
    <p>
      {ROWS.length} requirements from {AUTHORITIES.length} authorities, covering nursing homes, hospitals, VA medical facilities,
      and outpatient therapy organizations. Each is paired with the record that shows it was met, how often, and who the text
      names as responsible. Set a facility profile to keep only what applies. Prints as a survey-readiness checklist.
    </p>
  </div>
</BaseLayout>
