---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE_URL } from '../../lib/site';
import { LOOP, BREAKS } from '../../data/grievanceFile';

const blankRows = Array.from({ length: 10 });
---

<BaseLayout
  title="Grievance-to-Work-Order Loop: A Pest Grievance Log for Jails"
  description="A printable log template for jails and prisons that ties each pest grievance to its work order, response, follow-up check, and answer, so the records that show a reasonable response exist before anyone asks."
  breadcrumbs={[{ name: 'Tools', url: `${SITE_URL}/tools/` }, { name: 'Grievance-to-Work-Order Loop', url: `${SITE_URL}/tools/grievance-loop/` }]}
>
  <style is:global>
    .lede { font-size: 1.05rem; max-width: 46rem; }
    .dl { display: flex; flex-wrap: wrap; gap: 0.75rem; margin: 1.25rem 0 2rem; }
    .btn { display: inline-block; padding: 0.55rem 1rem; border-radius: 4px; border: 1px solid var(--color-primary); background: var(--color-primary); color: #fff; font: inherit; font-size: 0.92rem; cursor: pointer; text-decoration: none; }
    .btn.secondary { background: transparent; color: var(--color-primary); }
    ol.loop { list-style: none; padding: 0; margin: 1rem 0 1.75rem; display: grid; grid-template-columns: repeat(auto-fit, minmax(10.5rem, 1fr)); gap: 0.6rem; counter-reset: step; }
    ol.loop li { border: 1px solid var(--color-rule); border-top: 3px solid var(--color-primary); border-radius: 4px; padding: 0.65rem 0.75rem; font-size: 0.86rem; counter-increment: step; }
    ol.loop li strong { display: block; font-size: 0.95rem; margin-bottom: 0.25rem; }
    ol.loop li strong::before { content: counter(step) ". "; }
    ol.loop .rec { display: block; margin-top: 0.35rem; color: var(--color-text-muted); font-size: 0.8rem; }
    ol.loop .qs { display: block; margin-top: 0.3rem; font-size: 0.74rem; font-weight: 700; color: var(--color-text-meta); text-transform: uppercase; letter-spacing: 0.03em; }
    ol.breaks { max-width: 46rem; }
    ol.breaks li { margin: 0.3rem 0; }
    .fields { display: grid; grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr)); gap: 0.6rem 1.5rem; margin: 0 0 0.75rem; font-size: 0.92rem; }
    .fields span { display: block; border-bottom: 1px solid currentColor; padding-top: 1.1rem; }
    .scroll { overflow-x: auto; }
    table.log { width: 100%; min-width: 60rem; border-collapse: collapse; font-size: 0.8rem; margin: 0.5rem 0 1.25rem; }
    table.log th, table.log td { border: 1px solid var(--color-text-meta); padding: 0.4rem; vertical-align: top; text-align: left; }
    table.log thead th { font-size: 0.7rem; line-height: 1.25; background: rgba(31, 45, 58, 0.06); }
    table.log thead th small { display: block; font-weight: 400; color: var(--color-text-meta); margin-top: 0.15rem; }
    table.log td { height: 2.6rem; }
    .print-only { display: none; }
    @media print {
      @page { size: letter landscape; margin: 0.4in; }
      html { font-size: 10.5px !important; }
      body { background: #fff !important; }
      main { max-width: none !important; margin: 0 !important; padding: 0 !important; }
      main h1 { font-size: 2.2rem; margin: 0 0 0.4rem; }
      main h2 { font-size: 1.35rem; margin: 0.8rem 0 0.4rem; }
      .site-header, .site-footer, nav, .breadcrumbs, .no-print, .dl { display: none !important; }
      .print-only { display: block; font-size: 0.85rem; color: #555; margin-top: 0.4rem; }
      .lede { max-width: none; }
      ol.loop { grid-template-columns: repeat(5, 1fr); gap: 0.5rem; margin: 0.4rem 0 0.8rem; }
      ol.loop li { padding: 0.5rem 0.6rem; }
      ol.breaks { max-width: none; }
      table.log { min-width: 0; font-size: 0.85rem; }
      table.log td { height: 0.5in; }
      .scroll { overflow: visible; }
      a { color: inherit; text-decoration: none; }
      .page-2 { page-break-before: always; }
    }
  </style>

  <h1>Grievance-to-Work-Order Loop</h1>
  <p class="lede">
    Every pest grievance should close a loop: it is received, it becomes a work order, someone responds, someone checks the result,
    and the grievance is answered. This template keeps that loop on one page, one row per grievance, so the records that answer the
    <a href="/tools/vermin-grievance-file/">eight questions</a> already exist before anyone asks for them.
  </p>

  <div class="dl no-print">
    <button type="button" class="btn" onclick="window.print()">Print or save as PDF</button>
    <a class="btn secondary" href="/downloads/Grievance_to_Work_Order_Loop_Template.pdf" download>Download PDF</a>
    <a class="btn secondary" href="/tools/vermin-grievance-file/">The eight questions</a>
  </div>

  <h2>The loop</h2>
  <ol class="loop">
    {LOOP.map((s) => (
      <li>
        <strong>{s.step}</strong>
        {s.what}
        <span class="rec">Record: {s.record}</span>
        <span class="qs">Answers question{s.questions.length > 1 ? 's' : ''} {s.questions.join(', ')}</span>
      </li>
    ))}
  </ol>

  <h2>Where the loop usually breaks</h2>
  <ol class="breaks">
    {BREAKS.map((b) => <li>{b}</li>)}
  </ol>

  <div class="page-2">
    <h2>Pest grievance log</h2>
    <div class="fields">
      <div>Facility / housing area<span></span></div>
      <div>Log period<span></span></div>
      <div>Kept by<span></span></div>
    </div>
    <div class="scroll">
      <table class="log">
        <thead>
          <tr>
            <th scope="col">Grievance or kite no.<small>date and time received</small></th>
            <th scope="col">Location and pest reported<small>unit, cell, or area</small></th>
            <th scope="col">Received by, sent to<small>names and date</small></th>
            <th scope="col">Work order no.<small>date opened</small></th>
            <th scope="col">Responded by<small>staff or vendor; license no.</small></th>
            <th scope="col">Found, and applied or installed<small>product, EPA Reg. No., amount; devices</small></th>
            <th scope="col">Person moved?<small>Y / N; where logged</small></th>
            <th scope="col">Follow-up<small>date and result</small></th>
            <th scope="col">Answer to grievant<small>date</small></th>
            <th scope="col">Answer matches work record?<small>Y / N</small></th>
          </tr>
        </thead>
        <tbody>
          {blankRows.map(() => (
            <tr><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td></tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="print-only">
      Corrections Pest Reference · correctionspestreference.org/tools/grievance-loop/ · Trenton S. Frazer, M.S., BCE #B3413
    </p>
  </div>

  <p class="no-print">
    Complaints that come from staff, a health inspection, or a pest control visit belong in the same log, so every pest report
    follows the same loop. For what a Utah service record must contain, see
    <a href="/authorities/utah-r68-7-pesticide-applicator/">Utah R68-7</a>. For a review of how a facility's recent grievances
    moved through this loop, see the <a href="/consulting/#vermin-grievance-file-review">Vermin Grievance File Review</a>.
  </p>
</BaseLayout>
