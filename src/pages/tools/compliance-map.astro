---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE_URL, CONTACT_EMAIL } from '../../lib/site';
import { AUTHORITIES, ROWS, CADENCE_LABELS, CADENCE_ORDER, STATES, OSHA_PUBLIC, checklistFile } from '../../data/complianceMap';

const stateNameByCode = Object.fromEntries(STATES.map((s) => [s.code, s.name]));
const groupLabel = (a: (typeof AUTHORITIES)[number]) => (a.group === 'Other states' && a.state ? stateNameByCode[a.state] : a.group);
const isFederal = (a: (typeof AUTHORITIES)[number]) => a.group.startsWith('Federal');
const byAuth = AUTHORITIES.map((a, i) => ({ ...a, i, label: groupLabel(a), rows: ROWS.filter((r) => r.auth === a.key) }))
  .sort((x, y) => (isFederal(x) === isFederal(y) ? (isFederal(x) ? x.i - y.i : x.label.localeCompare(y.label) || x.i - y.i) : isFederal(x) ? -1 : 1));
const authNames = Object.fromEntries(AUTHORITIES.map((a) => [a.key, a.name]));
const authSlugs = Object.fromEntries(AUTHORITIES.map((a) => [a.key, a.slug]));
const authState = Object.fromEntries(AUTHORITIES.filter((a) => a.state).map((a) => [a.key, a.state]));
const authScope = Object.fromEntries(AUTHORITIES.filter((a) => a.scope).map((a) => [a.key, a.scope]));
const stateNames = Object.fromEntries(STATES.map((s) => [s.code, s.name]));
const pdfFiles = Object.fromEntries(STATES.map((s) => [s.code, checklistFile(s.name)]));
const pdfUtah = { slco: checklistFile('Utah', 'Salt_Lake_County_Jail'), prison: checklistFile('Utah', 'Utah_State_Prison') };
const rowCount = ROWS.length;
---

<BaseLayout
  title="Pest Compliance Map for Jails, Prisons, and Detention Facilities"
  description="Select a facility profile in any of 30 states and see which pest control authorities apply, what each requires, the record that proves it, how often, and who the text names as responsible. Print it, download a PDF checklist, or export a spreadsheet."
  breadcrumbs={[{ name: 'Tools', url: `${SITE_URL}/tools/` }, { name: 'Compliance Map', url: `${SITE_URL}/tools/compliance-map/` }]}
>
  <style is:global>
    .lede { font-size: 1.05rem; max-width: 46rem; }
    .notice { border-left: 3px solid var(--color-accent); padding: 0.75rem 1rem; background: rgba(58, 90, 120, 0.06); font-size: 0.92rem; max-width: 46rem; margin: 1.5rem 0 2rem; }
    .profile { border: 1px solid var(--color-rule); border-radius: 6px; padding: 1.25rem; margin: 0 0 2rem; }
    .profile h2 { margin-top: 0; font-size: 1.15rem; }
    .fields { display: grid; grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr)); gap: 1rem 1.5rem; }
    .field label, .field legend { font-weight: 600; font-size: 0.9rem; display: block; margin-bottom: 0.35rem; }
    .field select { width: 100%; padding: 0.45rem; font: inherit; border: 1px solid var(--color-rule); border-radius: 4px; background: transparent; color: inherit; }
    .field fieldset { border: 0; margin: 0; padding: 0; }
    .field .hint { font-size: 0.8rem; color: var(--color-text-muted); margin: 0.3rem 0 0; }
    .opt { display: flex; gap: 0.5rem; align-items: flex-start; font-size: 0.92rem; margin: 0.25rem 0; font-weight: 400 !important; }
    .opt input { margin-top: 0.2rem; }
    .actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.25rem; }
    .btn { display: inline-block; padding: 0.55rem 1rem; border-radius: 4px; border: 1px solid var(--color-primary); background: var(--color-primary); color: #fff; font: inherit; font-size: 0.92rem; cursor: pointer; text-decoration: none; }
    .btn.secondary { background: transparent; color: var(--color-primary); }
    .downloads-note { font-size: 0.8rem; color: var(--color-text-muted); margin: 0.6rem 0 0; }
    .summary { margin: 0 0 2rem; }
    .summary ul { list-style: none; padding: 0; margin: 0.5rem 0 0; }
    .summary li { padding: 0.35rem 0; border-bottom: 1px solid var(--color-rule); font-size: 0.93rem; }
    .scope-note { font-size: 0.9rem; border-left: 3px solid #8a5a00; padding: 0.5rem 0.75rem; margin: 0.75rem 0 0; max-width: 46rem; }
    .badge { display: inline-block; font-size: 0.72rem; font-weight: 700; letter-spacing: 0.03em; text-transform: uppercase; padding: 0.1rem 0.45rem; border-radius: 3px; margin-right: 0.5rem; }
    .badge.applies { background: #1f5c3a; color: #fff; }
    .badge.check { background: #8a5a00; color: #fff; }
    .badge.na { background: #6b7280; color: #fff; }
    .reason { color: var(--color-text-muted); font-size: 0.86rem; display: block; margin-top: 0.15rem; }
    .cadence { display: grid; grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr)); gap: 0.75rem; margin: 0.75rem 0 2rem; }
    .cad { border: 1px solid var(--color-rule); border-radius: 6px; padding: 0.75rem; font-size: 0.86rem; }
    .cad h3 { font-size: 0.95rem; margin: 0 0 0.35rem; }
    .cad ul { margin: 0; padding-left: 1rem; }
    table.map { width: 100%; border-collapse: collapse; font-size: 0.9rem; margin-bottom: 2rem; }
    table.map th, table.map td { border-bottom: 1px solid var(--color-rule); padding: 0.55rem 0.5rem; vertical-align: top; text-align: left; }
    table.map thead th { font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.04em; color: var(--color-text-meta); }
    tr.auth-head th { background: rgba(31, 45, 58, 0.06); font-size: 0.95rem; padding-top: 0.75rem; }
    tr.auth-head a { color: var(--color-primary); }
    .cite { font-size: 0.78rem; color: var(--color-text-meta); display: block; margin-top: 0.2rem; }
    details.q summary { cursor: pointer; font-size: 0.8rem; color: var(--color-accent); margin-top: 0.3rem; }
    details.q blockquote { margin: 0.35rem 0 0; font-size: 0.84rem; }
    .ident { font-size: 0.78rem; color: var(--color-text-muted); display: block; margin-top: 0.3rem; font-style: italic; }
    .should { font-size: 0.72rem; font-weight: 700; color: #8a5a00; }
    .box { width: 1rem; height: 1rem; border: 1.5px solid currentColor; display: inline-block; vertical-align: middle; }
    .print-only { display: none; }
    [hidden] { display: none !important; }
    @media (max-width: 720px) {
      table.map thead { display: none; }
      table.map tr { display: block; border-bottom: 1px solid var(--color-rule); padding: 0.5rem 0; }
      table.map td, table.map th { display: block; border: 0; padding: 0.2rem 0; }
      table.map td[data-label]::before { content: attr(data-label) ": "; font-weight: 600; font-size: 0.8rem; color: var(--color-text-meta); }
      td.col-box { display: none; }
    }
    @media print {
      @page { size: letter; margin: 0.55in; }
      .site-header, .site-footer, nav, .profile, .actions, .no-print, .breadcrumbs, details.q summary { display: none !important; }
      .print-only { display: block; }
      details.q { display: none; }
      body { font-size: 10pt; }
      table.map { font-size: 8.5pt; }
      table.map tr { page-break-inside: avoid; }
      .cad { page-break-inside: avoid; }
      a { color: inherit; text-decoration: none; }
    }
  </style>

  <h1>Pest Compliance Map</h1>
  <p class="lede">
    Every pest control requirement on this reference, in one place: what the authority requires, the record that shows it was met,
    how often, and who the text names as responsible. It covers the federal detention standards and the jail pest provisions of
    {STATES.length} states. Set your facility's profile and the map keeps only the authorities that reach it. Print it, download it as a
    PDF checklist, or export it as a spreadsheet.
  </p>
  <p class="notice">
    This map lists what each authority's text requires and the record that would show it. It is not a determination that any
    facility complies, and it is not legal advice. Which authorities govern a facility is set by its jurisdiction, its operator,
    and its agreements. Every requirement links to the authority page that quotes the source.
  </p>

  <div class="print-only">
    <p><strong>Facility:</strong> ______________________________ &nbsp; <strong>Reviewed by:</strong> ______________________ &nbsp; <strong>Date:</strong> ____________</p>
    <p><strong>Profile:</strong> <span id="print-profile">All authorities</span></p>
    <p class="cite">From the Pest Compliance Map, {SITE_URL.replace('https://', '')}/tools/compliance-map/, <span id="print-date"></span>. Maintained by Trenton S. Frazer, Board Certified Entomologist (BCE #B3413).</p>
  </div>

  <form class="profile no-print" id="profile" onsubmit="return false">
    <h2>Facility profile</h2>
    <div class="fields">
      <div class="field">
        <label for="f-state">State</label>
        <select id="f-state" name="state">
          <option value="" selected>Choose your state</option>
          {STATES.map((s) => <option value={s.code}>{s.name}</option>)}
          <option value="OTHER">Another state (not yet on this reference)</option>
        </select>
        <p class="hint">{STATES.length} states are on this reference. To suggest one, <a href="https://frazerappliedentomology.com/contact/">write to the author</a>.</p>
      </div>
      <div class="field">
        <label for="f-op">Who operates it</label>
        <select id="f-op" name="op">
          <option value="county" selected>County jail</option>
          <option value="state">State prison</option>
          <option value="bop">Federal Bureau of Prisons institution</option>
          <option value="private">Privately operated facility</option>
        </select>
      </div>
      <div class="field">
        <label for="f-ice">ICE detainees</label>
        <select id="f-ice" name="ice">
          <option value="none" selected>None</option>
          <option value="pbnds">Yes, agreement uses PBNDS 2011</option>
          <option value="nds">Yes, agreement uses NDS 2019</option>
          <option value="unsure">Yes, not sure which standards</option>
        </select>
      </div>
      <div class="field">
        <fieldset>
          <legend>Also true of this facility</legend>
          <label class="opt"><input type="checkbox" id="f-kitchen" checked /> Food is prepared on site</label>
          <label class="opt"><input type="checkbox" id="f-usms" /> Holds U.S. Marshals Service prisoners under a detention agreement</label>
          <label class="opt" id="opt-udc"><input type="checkbox" id="f-udc" checked /> Houses Utah state inmates</label>
          <label class="opt" id="opt-slco"><input type="checkbox" id="f-slco" /> Located in Salt Lake County</label>
        </fieldset>
      </div>
    </div>
    <div class="actions">
      <button type="button" class="btn" id="print-btn">Print checklist or save as PDF</button>
      <a class="btn secondary" id="pdf-link" download hidden>Download ready-made PDF</a>
      <button type="button" class="btn secondary" id="csv-btn" hidden>Download spreadsheet (CSV)</button>
      <a class="btn secondary" id="review-link" href="https://frazerappliedentomology.com/contact/">Request an applicability review</a>
    </div>
    <p class="downloads-note" id="downloads-note" hidden></p>
  </form>

  <section class="summary" id="summary" aria-live="polite">
    <h2>Authorities for this profile</h2>
    <p class="no-print" id="summary-fallback">All {AUTHORITIES.length} authorities and {rowCount} requirements are shown below. Turn on JavaScript to filter them to a facility profile.</p>
    <ul id="summary-list"></ul>
    <p class="scope-note" id="scope-note" hidden></p>
  </section>

  <section id="cadence-section" hidden>
    <h2>Proof calendar</h2>
    <p class="no-print">How often each record has to exist, for this profile.</p>
    <div class="cadence" id="cadence"></div>
  </section>

  <h2>Requirements and proof records</h2>
  <table class="map">
    <thead>
      <tr>
        <th class="col-box" scope="col">On file</th>
        <th scope="col">Requirement</th>
        <th scope="col">Record that shows it</th>
        <th scope="col">How often</th>
        <th scope="col">Named responsible</th>
      </tr>
    </thead>
    {byAuth.map((a) => (
      <tbody data-auth={a.key}>
        <tr class="auth-head">
          <th colspan="5" scope="rowgroup">
            <a href={`/authorities/${a.slug}/`}>{a.name}</a>
            <span class="cite">{a.label}</span>
          </th>
        </tr>
        {a.rows.map((r) => (
          <tr data-row={r.id} data-kitchen={r.kitchen ? '1' : '0'} data-cad={r.cadence.join(' ')}>
            <td class="col-box"><span class="box" aria-hidden="true"></span></td>
            <td data-label="Requirement">
              <span class="req">{r.requirement}</span>
              {r.should && <span class="should"> SHOULD</span>}
              {r.recommended && <span class="should"> RECOMMENDED</span>}
              <span class="cite">{a.name}, {r.cite}</span>
              {r.identifierOnly
                ? <span class="ident">Copyrighted standard, recorded by identifier. The authority page summarizes it; the text is not reproduced.</span>
                : <details class="q"><summary>Source text</summary><blockquote>"{r.quote}"</blockquote></details>}
            </td>
            <td data-label="Record">{r.evidence}</td>
            <td data-label="How often">{r.frequency}</td>
            <td data-label="Named responsible">{r.owner}</td>
          </tr>
        ))}
      </tbody>
    ))}
  </table>

  <p class="no-print">
    Want the facility-specific version, checked against your agreements and walked on site? See
    <a href="/consulting/">Consulting</a>. Writing a pest control contract? Start from the
    <a href="/tools/scope-of-work/" id="sow-link">model scope of work</a>, filled in for this profile. Comparing states? See the
    <a href="/state-jail-standards/">{STATES.length}-state comparison</a>.
  </p>

  <script>
    import { status } from '../../lib/applicability.js';
    (window as any).CPRApplicability = { status };
  </script>

  <script define:vars={{ AUTH_NAMES: authNames, AUTH_SLUGS: authSlugs, AUTH_STATE: authState, AUTH_SCOPE: authScope, STATE_NAMES: stateNames, OSHA_PUBLIC, PDF_FILES: pdfFiles, PDF_UTAH: pdfUtah, CAD_LABELS: CADENCE_LABELS, CAD_ORDER: CADENCE_ORDER, EMAIL: CONTACT_EMAIL, SITE: SITE_URL }}>
    function boot() {
      var $ = function (id) { return document.getElementById(id); };
      var F = { state: $('f-state'), op: $('f-op'), ice: $('f-ice'), kitchen: $('f-kitchen'), usms: $('f-usms'), udc: $('f-udc'), slco: $('f-slco') };
      var OPS = { county: 'County jail', state: 'State prison', bop: 'Federal Bureau of Prisons institution', 'private': 'Privately operated facility' };
      function stateName(c) { return c === 'OTHER' ? 'Another state' : (STATE_NAMES[c] || 'No state chosen'); }

      // A profile can arrive in the URL (?state=PA&op=county&kitchen=1), so a filtered map can be linked or printed.
      (function readParams() {
        var q = new URLSearchParams(location.search);
        var st = (q.get('state') || '').toUpperCase();
        if (st && (STATE_NAMES[st] || st === 'OTHER')) F.state.value = st;
        if (q.get('op') && OPS[q.get('op')]) F.op.value = q.get('op');
        if (q.get('ice') && ['none', 'pbnds', 'nds', 'unsure'].indexOf(q.get('ice')) >= 0) F.ice.value = q.get('ice');
        ['kitchen', 'usms', 'udc', 'slco'].forEach(function (k) { var v = q.get(k); if (v === '1' || v === '0') F[k].checked = v === '1'; });
      })();
      function writeParams(a) {
        var q = new URLSearchParams({ state: a.state, op: a.op, ice: a.ice, kitchen: a.kitchen ? '1' : '0', usms: a.usms ? '1' : '0', udc: a.udc ? '1' : '0', slco: a.slco ? '1' : '0' });
        try { history.replaceState(null, '', location.pathname + '?' + q.toString()); } catch (e) {}
        var sl = document.getElementById('sow-link');
        if (sl) sl.setAttribute('href', '/tools/scope-of-work/' + (a.state ? '?' + q.toString() : ''));
      }

      function answers() {
        return { state: F.state.value, op: F.op.value, ice: F.ice.value, kitchen: F.kitchen.checked, usms: F.usms.checked, udc: F.udc.checked, slco: F.slco.checked };
      }
      var CTX = { AUTH_STATE: AUTH_STATE, AUTH_SCOPE: AUTH_SCOPE, OSHA_PUBLIC: OSHA_PUBLIC, STATE_NAMES: STATE_NAMES };
      function status(key, a) { return window.CPRApplicability.status(key, a, CTX); }
      function profileText(a) {
        var p = [stateName(a.state), OPS[a.op]];
        if (a.state === 'UT' && (a.op === 'county' || a.op === 'private')) p.push(a.udc ? 'houses state inmates' : 'no state inmates');
        if (a.state === 'UT' && a.slco) p.push('Salt Lake County');
        p.push(a.ice === 'none' ? 'no ICE detainees' : a.ice === 'pbnds' ? 'ICE (PBNDS 2011)' : a.ice === 'nds' ? 'ICE (NDS 2019)' : 'ICE (standards unconfirmed)');
        if (a.usms) p.push('USMS prisoners');
        p.push(a.kitchen ? 'food prepared on site' : 'no food prepared on site');
        return p.join(' · ');
      }
      // The ready-made PDF matches the default profile for its state: food on site, no ICE, no USMS.
      function readyPdf(a) {
        if (a.ice !== 'none' || a.usms || !a.kitchen) return null;
        if (a.state === 'UT') {
          if (a.op === 'state') return { file: PDF_UTAH.prison, label: 'Utah state prison' };
          if (a.op === 'county' && a.slco && a.udc) return { file: PDF_UTAH.slco, label: 'Salt Lake County jail' };
          if (a.op === 'county' && !a.slco && a.udc) return { file: PDF_FILES.UT, label: 'Utah county jail' };
          return null;
        }
        if (a.op === 'county' && PDF_FILES[a.state]) return { file: PDF_FILES[a.state], label: STATE_NAMES[a.state] + ' county jail' };
        return null;
      }
      var LABEL = { applies: 'Applies', check: 'Check', na: 'Does not apply' };
      var current = { active: {}, a: null };
      function render() {
        var a = answers();
        $('opt-udc').hidden = !(a.state === 'UT' && (a.op === 'county' || a.op === 'private'));
        $('opt-slco').hidden = !(a.state === 'UT' && a.op !== 'bop');
        if ($('opt-slco').hidden) { a.slco = false; }
        if ($('opt-udc').hidden && a.state !== 'UT') { a.udc = false; }
        $('summary-fallback').hidden = true;
        var active = {};
        Object.keys(AUTH_NAMES).forEach(function (k) { var st = status(k, a); if (st) active[k] = st; });
        current = { active: active, a: a };
        var list = $('summary-list');
        list.innerHTML = '';
        ['applies', 'check', 'na'].forEach(function (s) {
          Object.keys(active).filter(function (k) { return active[k].s === s; }).forEach(function (k) {
            var li = document.createElement('li');
            var badge = document.createElement('span');
            badge.className = 'badge ' + s;
            badge.textContent = LABEL[s];
            var link = document.createElement('a');
            link.setAttribute('href', ['', 'authorities', AUTH_SLUGS[k], ''].join('/'));
            link.textContent = AUTH_NAMES[k];
            var reason = document.createElement('span');
            reason.className = 'reason';
            reason.textContent = active[k].why;
            li.appendChild(badge);
            li.appendChild(link);
            li.appendChild(reason);
            list.appendChild(li);
          });
        });
        var hasState = Object.keys(active).some(function (k) { return AUTH_STATE[k] || ['udc', 'r392', 'r687', 'slco', 'grama'].indexOf(k) >= 0; });
        var note = $('scope-note');
        note.hidden = true;
        if (!a.state) {
          note.textContent = 'Choose your state to add its jail standard and any other state rules on this reference. Until then, the map shows the federal authorities.';
          note.hidden = false;
        } else if (a.state === 'OTHER') {
          note.textContent = 'Your state\'s jail pest provision is not on this reference yet. The federal and food-code authorities above are marked as they apply; ask for an applicability review to have your state\'s rules read against the facility.';
          note.hidden = false;
        } else if (!hasState && a.op !== 'bop') {
          note.textContent = 'No ' + stateName(a.state) + ' authority on this reference reaches a ' + OPS[a.op].toLowerCase() + ' yet. The state jail standards here are written for local facilities.';
          note.hidden = false;
        }
        var cad = {};
        document.querySelectorAll('tbody[data-auth]').forEach(function (tb) {
          var k = tb.getAttribute('data-auth');
          var st = active[k];
          var show = !!st && st.s !== 'na';
          var visible = 0;
          tb.querySelectorAll('tr[data-row]').forEach(function (tr) {
            var hide = !show || (tr.getAttribute('data-kitchen') === '1' && !a.kitchen);
            tr.hidden = hide;
            if (!hide) {
              visible++;
              var cite = tr.querySelector('.cite').textContent;
              tr.getAttribute('data-cad').split(' ').forEach(function (c) { (cad[c] = cad[c] || []).push(cite); });
            }
          });
          tb.hidden = !show || visible === 0;
          var head = tb.querySelector('.auth-head th');
          head.querySelectorAll('.badge').forEach(function (b) { b.remove(); });
          if (show) {
            var b = document.createElement('span');
            b.className = 'badge ' + st.s;
            b.textContent = LABEL[st.s];
            head.insertBefore(b, head.firstChild);
          }
        });
        var box = $('cadence');
        box.innerHTML = '';
        CAD_ORDER.forEach(function (c) {
          if (!cad[c]) return;
          var d = document.createElement('div');
          d.className = 'cad';
          var h = document.createElement('h3');
          h.textContent = CAD_LABELS[c] + ' ';
          var n = document.createElement('span');
          n.className = 'cite';
          n.textContent = cad[c].length + ' requirement' + (cad[c].length === 1 ? '' : 's');
          h.appendChild(n);
          var ul = document.createElement('ul');
          cad[c].forEach(function (x) { var li = document.createElement('li'); li.textContent = x; ul.appendChild(li); });
          d.appendChild(h);
          d.appendChild(ul);
          box.appendChild(d);
        });
        $('cadence-section').hidden = Object.keys(cad).length === 0;
        var prof = profileText(a);
        $('print-profile').textContent = prof;
        $('print-date').textContent = new Date().toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
        var pdf = readyPdf(a);
        var pl = $('pdf-link');
        pl.hidden = !pdf;
        if (pdf) { pl.href = '/downloads/' + pdf.file; pl.textContent = 'Download ' + pdf.label + ' PDF'; }
        $('csv-btn').hidden = false;
        var dn = $('downloads-note');
        dn.hidden = false;
        dn.textContent = pdf
          ? 'The ready-made PDF is the standard ' + pdf.label + ' profile. For any other profile, use Print and choose Save as PDF.'
          : 'No ready-made PDF for this exact profile. Use Print and choose Save as PDF, or download the spreadsheet.';
        writeParams(a);
      }

      function csvCell(v) { return '"' + String(v == null ? '' : v).replace(/\s+/g, ' ').trim().replace(/"/g, '""') + '"'; }
      function downloadCsv() {
        var a = current.a || answers();
        var out = [['On file', 'Authority', 'Status for this profile', 'Why', 'Citation', 'Requirement', 'Source text (verbatim)', 'Record that shows it', 'How often', 'Named responsible', 'Authority page']];
        document.querySelectorAll('tbody[data-auth]').forEach(function (tb) {
          if (tb.hidden) return;
          var k = tb.getAttribute('data-auth');
          var st = current.active[k];
          tb.querySelectorAll('tr[data-row]').forEach(function (tr) {
            if (tr.hidden) return;
            var td = tr.querySelectorAll('td');
            var bq = tr.querySelector('blockquote');
            var quote = bq ? bq.textContent.replace(/^"|"$/g, '') : 'Copyrighted standard, recorded by identifier; text not reproduced';
            out.push(['', AUTH_NAMES[k], st ? LABEL[st.s] : '', st ? st.why : '', tr.querySelector('.cite').textContent,
              tr.querySelector('.req').textContent, quote, td[2].textContent, td[3].textContent, td[4].textContent,
              SITE + '/authorities/' + AUTH_SLUGS[k] + '/']);
          });
        });
        out.push([]);
        out.push(['', 'Profile: ' + profileText(a)]);
        out.push(['', 'From the Pest Compliance Map, ' + SITE + '/tools/compliance-map/. Lists what each authority\'s text requires and the record that would show it. Not a compliance determination and not legal advice.']);
        var csv = '﻿' + out.map(function (r) { return r.map(csvCell).join(','); }).join('\r\n');
        var blob = new Blob([csv], { type: 'text/csv;charset=utf-8' });
        var url = URL.createObjectURL(blob);
        var link = document.createElement('a');
        link.href = url;
        link.download = 'Pest_Compliance_Map_' + stateName(a.state).replace(/ /g, '_') + '_' + OPS[a.op].replace(/ /g, '_') + '.csv';
        document.body.appendChild(link);
        link.click();
        setTimeout(function () { URL.revokeObjectURL(url); link.remove(); }, 1000);
      }

      Object.keys(F).forEach(function (k) { F[k].addEventListener('change', render); });
      $('print-btn').addEventListener('click', function () { window.print(); });
      $('csv-btn').addEventListener('click', downloadCsv);
      render();
    }
    if (window.CPRApplicability) boot(); else document.addEventListener('DOMContentLoaded', boot);
  </script>
</BaseLayout>
