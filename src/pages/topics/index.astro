---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE_URL } from '../../lib/site';
import { getCollection } from 'astro:content';

const entries = (await getCollection('topics')).sort((a, b) => a.data.title.localeCompare(b.data.title));
---

<BaseLayout
  title="Topics"
  description="Questions healthcare facilities ask that cut across several regulatory authorities, answered from the primary sources with links to each governing authority page."
  breadcrumbs={[{ name: 'Topics', url: `${SITE_URL}/topics/` }]}
>
  <style>
    .topic-list {
      list-style: none;
      margin: 0;
      padding: 0;
    }

    .topic-list li {
      padding: 1rem 0;
      border-bottom: 1px solid var(--color-rule);
    }

    .topic-list li:last-child {
      border-bottom: none;
    }

    .topic-list a {
      font-family: var(--font-serif);
      font-size: 1.1rem;
      font-weight: 500;
      color: var(--color-primary);
      text-decoration: none;
      display: block;
      margin-bottom: 0.3rem;
    }

    .topic-list a:hover {
      color: var(--color-accent);
      text-decoration: underline;
    }

    .topic-summary {
      margin: 0;
      font-size: 0.9rem;
      color: var(--color-text-muted);
    }
  </style>

  <h1>Topics</h1>

  <p>
    Some questions do not belong to one authority. A topic page answers one such
    question from the primary sources and points to each governing authority page
    for the underlying regulation or standard.
  </p>

  <ul class="topic-list">
    {entries.map((entry) => (
      <li>
        <a href={`/topics/${entry.slug}/`}>{entry.data.title}</a>
        {entry.data.summary && <p class="topic-summary">{entry.data.summary}</p>}
      </li>
    ))}
  </ul>
</BaseLayout>
