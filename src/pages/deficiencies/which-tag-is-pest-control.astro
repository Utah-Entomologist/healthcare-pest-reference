---
import BaseLayout from '../../layouts/BaseLayout.astro';
import JsonLd from '../../components/JsonLd.astro';
import CitationBlock from '../../components/CitationBlock.astro';
import { articleSchema, personSchema } from '../../lib/schema';
import { SITE_URL } from '../../lib/site';

/**
 * Router page: the one-screen answer to "which tag is pest control?" for a
 * facility that has just been cited, or that typed a tag number that does
 * not exist. Every entry links to the full page that carries the verbatim
 * text; nothing here is quoted beyond an identifier and a public statement.
 */
const permalink = `${SITE_URL}/deficiencies/which-tag-is-pest-control/`;
const title = 'Which Tag Is Pest Control? CMS, Joint Commission, VA, and Food Code Citations by Facility Type';
const description =
  'Which survey tag or standard a pest finding is cited under, by facility type: nursing homes (F925, 42 CFR §483.90(i)(4), explicit), hospitals (A-0701, A-0724, or A-0750; no explicit pest tag exists and A-0758 does not exist), clinics and rehabilitation agencies (42 CFR §485.725(e), explicit), critical access hospitals (no explicit standard), The Joint Commission (PE.01.01.01), the VA (VHA Directive 1850.02), and food service areas (FDA Food Code 6-501.111). Each entry links to the full page.';
const lastVerified = new Date('2026-09-11T00:00:00Z');

const article = articleSchema({
  url: permalink,
  headline: title,
  description,
  datePublished: '2026-09-11',
  dateModified: '2026-09-11',
  citation:
    '42 CFR §483.90(i)(4); 42 CFR §482.41 and §482.42(a)(3); 42 CFR §485.725(e); CMS State Operations Manual Appendix PP Rev. 232 and Appendix A Rev. 238; VHA Directive 1850.02; FDA Food Code 2022 §6-501.111',
  citationUrl: 'https://www.ecfr.gov/current/title-42/chapter-IV/subchapter-G'
});

const rows = [
  {
    who: 'Nursing home (skilled nursing facility or nursing facility, 42 CFR Part 483)',
    tag: 'F925',
    reg: '42 CFR §483.90(i)(4)',
    kind: 'Explicit mandate',
    note:
      '“Maintain an effective pest control program so that the facility is free of pests and rodents.” CMS defines the program and names the pests (bed bugs, lice, roaches, ants, mosquitoes, flies, mice, and rats). Kitchen findings also route here from F812.',
    href: '/deficiencies/f925/',
    also: [{ label: 'Plan of correction for F925', href: '/deficiencies/f925-plan-of-correction/' }]
  },
  {
    who: 'Hospital (42 CFR Part 482)',
    tag: 'A-0701 or A-0724, or A-0750',
    reg: '42 CFR §482.41(a) or §482.41(d)(2) (physical environment); 42 CFR §482.42(a)(3) (clean and sanitary environment)',
    kind: 'No explicit pest tag exists',
    note:
      'Appendix A Rev. 238 contains zero occurrences of pest, vermin, rodent, insect, or infestation. Physical-plant findings are written at A-0701 or A-0724; a finding framed as infection control is written at A-0750, far more often than at A-0749. A-0758 is not a tag.',
    href: '/deficiencies/a-0701-buildings/',
    also: [
      { label: 'A-0724 (with A-0722, Facilities)', href: '/deficiencies/a-0722-facilities/' },
      { label: 'A-0750 (clean and sanitary environment)', href: '/deficiencies/a-0750-sanitary-environment/' },
      { label: 'A-0758 does not exist', href: '/deficiencies/a-0758/' }
    ]
  },
  {
    who: 'Clinic, rehabilitation agency, or public health agency furnishing outpatient physical therapy or speech-language pathology services (42 CFR Part 485, Subpart H)',
    tag: '§485.725(e)',
    reg: '42 CFR §485.725(e), Standard: Pest control',
    kind: 'Explicit mandate',
    note:
      '“The organization’s premises are maintained free from insects and rodents through operation of a pest-control program.” Comprehensive outpatient rehabilitation facilities have a parallel provision at §485.62(b)(4).',
    href: '/authorities/485-725e-pest-control/',
    also: []
  },
  {
    who: 'Critical access hospital (42 CFR Part 485, Subpart F)',
    tag: 'No explicit standard',
    reg: '42 CFR §485.623(b), Standard: Maintenance (“The premises are clean and orderly”)',
    kind: 'By inference only',
    note:
      'Part 485 is widely read as the CAH rule, but the explicit pest standard in it is in Subpart H, not Subpart F. A CAH pest finding is written by inference under the maintenance standard, as a hospital finding is under §482.41.',
    href: '/authorities/485-725e-pest-control/',
    also: []
  },
  {
    who: 'Joint Commission-accredited hospital',
    tag: 'PE.01.01.01',
    reg: 'Comprehensive Accreditation Manual for Hospitals, Physical Environment chapter (effective January 1, 2026)',
    kind: 'Accreditor standard; no pest-specific Element of Performance',
    note:
      'Identifier and publicly stated requirement only: the standard for a safe, adequate environment, successor to EC.02.06.01. The standard text is proprietary and is not reproduced on this reference.',
    href: '/deficiencies/pe-01-01-01-safe-adequate-environment/',
    also: [{ label: 'PE.02.01.01 EP 4 (pesticide storage)', href: '/deficiencies/pe-02-01-01-hazardous-materials-and-waste/' }]
  },
  {
    who: 'VA medical facility (Veterans Health Administration)',
    tag: 'VHA Directive 1850.02',
    reg: 'Pest Management Operations Program, December 22, 2022',
    kind: 'Explicit federal directive',
    note:
      'Mandatory Integrated Pest Management Operations Plan, a designated Pest Management Officer, prior approval for applications in patient care and restricted areas, 48-hour response to sightings. Reviewed internally, not by CMS tag.',
    href: '/authorities/vha-directive-1850-02/',
    also: []
  },
  {
    who: 'Food service areas in any facility',
    tag: 'FDA Food Code 6-501.111',
    reg: 'FDA Food Code 2022, §6-501.111 Controlling Pests (as adopted by the state)',
    kind: 'Explicit requirement, applied by the state food inspector',
    note:
      'Four-part requirement: inspect incoming shipments, inspect the premises, use control methods when pests are found (Priority Foundation), and eliminate harborage. Applies alongside the CMS tag for the same kitchen.',
    href: '/authorities/fda-food-code-2022/',
    also: []
  }
];
---

<BaseLayout
  title={title}
  description={description}
  canonical={permalink}
  ogType="article"
  breadcrumbs={[
    { name: 'Deficiencies', url: `${SITE_URL}/deficiencies/` },
    { name: 'Which tag is pest control?', url: permalink }
  ]}
>
  <Fragment slot="head">
    <JsonLd data={personSchema()} />
    <JsonLd data={article} />
  </Fragment>

  <style>
    .deficiency-kicker {
      font-family: var(--font-sans);
      font-size: 0.72rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--color-text-meta);
      margin-bottom: 0.75rem;
    }

    .router-lede {
      font-family: var(--font-serif);
      font-size: 1.15rem;
      line-height: 1.55;
      margin-bottom: 1.5rem;
    }

    .router-list {
      list-style: none;
      margin: 0 0 2.5rem;
      padding: 0;
    }

    .router-list li {
      padding: 1.1rem 0;
      border-bottom: 1px solid var(--color-rule);
    }

    .router-list li:last-child {
      border-bottom: none;
    }

    .router-who {
      font-family: var(--font-sans);
      font-size: 0.78rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--color-text-meta);
      margin: 0 0 0.35rem;
    }

    .router-tag {
      font-family: var(--font-serif);
      font-size: 1.15rem;
      font-weight: 600;
      color: var(--color-primary);
      text-decoration: none;
      line-height: 1.35;
    }

    .router-tag:hover {
      color: var(--color-accent);
      text-decoration: underline;
    }

    .router-reg {
      font-family: 'SF Mono', Monaco, 'Cascadia Code', monospace;
      font-size: 0.82rem;
      color: var(--color-accent);
      margin: 0.25rem 0 0.4rem;
    }

    .router-kind {
      font-family: var(--font-sans);
      font-size: 0.8rem;
      font-weight: 600;
      color: var(--color-text-muted);
      margin: 0 0 0.4rem;
    }

    .router-note {
      font-size: 0.92rem;
      color: var(--color-text-muted);
      margin: 0 0 0.4rem;
    }

    .router-also {
      font-size: 0.86rem;
      margin: 0;
    }

    .router-also a {
      margin-right: 1rem;
    }

    .router-note-box {
      background: var(--color-bg-subtle);
      border-left: 3px solid var(--color-accent);
      padding: 1rem 1.3rem;
      margin: 0 0 2.5rem;
      font-size: 0.92rem;
      color: var(--color-text-muted);
    }
  </style>

  <p class="deficiency-kicker">Survey deficiency reference · Router</p>
  <h1>Which Tag Is Pest Control?</h1>

  <p class="router-lede">
    A pest finding is cited under a different identifier in every regime, and in two of
    them there is no pest-specific identifier at all. Find your facility type below; each
    entry links to the page that carries the verbatim text, what surveyors look for, and
    the plan-of-correction structure.
  </p>

  <p class="router-note-box">
    If the number on your paperwork is not in this list, it may not exist. The most common
    example is <a href="/deficiencies/a-0758/">A-0758</a>, which does not appear in the CMS
    hospital manual. Read the regulation text printed beneath the tag on your Form CMS-2567;
    the regulation, not the tag number, is what the plan of correction answers.
  </p>

  <ul class="router-list">
    {rows.map((r) => (
      <li>
        <p class="router-who">{r.who}</p>
        <a class="router-tag" href={r.href}>{r.tag}</a>
        <p class="router-reg">{r.reg}</p>
        <p class="router-kind">{r.kind}</p>
        <p class="router-note">{r.note}</p>
        {r.also.length > 0 && (
          <p class="router-also">
            {r.also.map((a) => <a href={a.href}>{a.label}</a>)}
          </p>
        )}
      </li>
    ))}
  </ul>

  <h2>Why the Regimes Differ</h2>

  <p>
    Only two federal Conditions of Participation name pests: the long-term care requirement
    at 42 CFR §483.90(i)(4) and the outpatient physical therapy provider standard at 42 CFR
    §485.725(e) (with a parallel provision for comprehensive outpatient rehabilitation
    facilities at §485.62(b)(4)). The hospital condition, 42 CFR Part 482, and its surveyor
    manual contain no pest vocabulary, so hospital surveyors write pest observations to the
    physical-environment and sanitary-environment tags by inference. The Joint Commission's
    physical environment chapter has no pest-specific Element of Performance. The VA, as an
    operator rather than a regulator, wrote its own directive. The Food Code is the one
    document in the list that describes, in a food area, what a pest control program has to
    do, which is why it is applied to hospital and nursing home kitchens alongside the CMS
    tag. Every statement above is drawn from the primary source quoted on the linked page.
  </p>

  <CitationBlock title={title} permalink={permalink} lastVerified={lastVerified} />
</BaseLayout>
