---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE_URL } from '../../lib/site';
import { getCollection } from 'astro:content';

const authorities = await getCollection('authorities');

const grouped = authorities.reduce((acc, authority) => {
  const type = authority.data.authority_type;
  if (!acc[type]) acc[type] = [];
  acc[type].push(authority);
  return acc;
}, {} as Record<string, typeof authorities>);

const typeOrder = ['federal regulator', 'federal agency standard', 'state regulator', 'state statute', 'local regulator', 'recognized authority'];

const typeLabels: Record<string, string> = {
  'federal regulator': 'Federal Regulators',
  'federal agency standard': 'Federal Detention and Corrections Standards',
  'state regulator': 'State Regulators',
  'state statute': 'State Statutes',
  'local regulator': 'Local Health Regulations',
  'recognized authority': 'Recognized Authorities'
};

const typeOrientation: Record<string, string> = {
  'federal regulator':
    'Federal regulations and the federal model code. OSHA applies to the facility as a workplace; the FDA Food Code becomes binding through state adoption and, for immigration detention, through ICE’s own food service standard.',
  'federal agency standard':
    'Standards published by the federal agencies that operate or contract for detention. They bind the facilities those agencies hold to them, as each agency states.',
  'state regulator':
    'Binding within the state. Pesticide control rules set who may apply what, and what record every application leaves.',
  'state statute':
    'Statutes. In Utah, these set who may be asked for jail standards and inspection results, and what counts as a correctional facility.',
  'local regulator':
    'Regulations adopted by a local board of health for correctional institutions in its jurisdiction, enforced by its own inspections.',
  'recognized authority':
    'Not regulations. Standards of practice that inspectors and counsel measure against when the regulation itself is silent.'
};
---

<BaseLayout
  title="Authorities"
  description="Index of every authority on the Corrections Pest Reference, grouped by authority class, with a one-line orientation for each."
  breadcrumbs={[{ name: 'Authorities', url: `${SITE_URL}/authorities/` }]}
>
  <style>
    .group { margin-bottom: 2.75rem; }
    .group-orientation { color: var(--color-text-muted); font-size: 0.95rem; }
    .authority-list { list-style: none; margin: 0; padding: 0; }
    .authority-list li { padding: 1rem 0; border-bottom: 1px solid var(--color-rule); margin: 0; }
    .authority-list li:last-child { border-bottom: none; }
    .authority-list a {
      font-family: var(--font-serif);
      font-size: 1.08rem;
      font-weight: 500;
      color: var(--color-primary);
      text-decoration: none;
      display: block;
      line-height: 1.35;
      margin-bottom: 0.3rem;
    }
    .authority-list a:hover { color: var(--color-accent); text-decoration: underline; text-underline-offset: 3px; }
    .authority-summary { margin: 0 0 0.3rem; font-size: 0.95rem; color: var(--color-text); }
    .authority-citation { font-size: 0.82rem; color: var(--color-text-meta); }
  </style>

  <h1>Authorities</h1>

  <p>
    Every authority on this reference, grouped by class. Each page gives the verbatim
    text, a plain-language reading, who the requirement applies to as the source states
    it, and the records that show it was met.
  </p>

  {typeOrder.map(type => grouped[type] && (
    <section class="group">
      <h2>{typeLabels[type]}</h2>
      <p class="group-orientation">{typeOrientation[type]}</p>
      <ul class="authority-list">
        {grouped[type]
          .sort((a, b) => a.data.title.localeCompare(b.data.title))
          .map(authority => (
            <li>
              <a href={`/authorities/${authority.slug}/`}>{authority.data.title}</a>
              {authority.data.summary && <p class="authority-summary">{authority.data.summary}</p>}
              <span class="authority-citation">{authority.data.citation}</span>
            </li>
          ))}
      </ul>
    </section>
  ))}
</BaseLayout>
