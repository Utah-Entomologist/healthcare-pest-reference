---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  CONSULTING_PRACTICE_NAME,
  CONSULTING_PRACTICE_URL,
  CONTACT_EMAIL,
  CONTACT_PHONE,
  CONTACT_PHONE_TEL,
  SITE_URL
} from '../lib/site';

const practice = CONSULTING_PRACTICE_NAME;
---

<BaseLayout
  title="Consulting"
  description={`${practice} is the professional consulting practice of Trenton S. Frazer, Board Certified Entomologist, author of the Corrections Pest Reference. Facility pest program assessment, contract and scope review, Entomologist of Record engagement, and expert witness work for jails, prisons, and detention facilities.`}
  breadcrumbs={[{ name: 'Consulting', url: `${SITE_URL}/consulting/` }]}
>
  <style>
    .separation {
      background: var(--color-bg-subtle);
      border-left: 3px solid var(--color-accent);
      padding: 1.1rem 1.4rem;
      margin: 0 0 2.5rem;
      font-size: 0.92rem;
      color: var(--color-text-muted);
    }
    .separation strong { color: var(--color-primary); }
    .services { margin-bottom: 1.5rem; }
    .services dt { font-family: var(--font-sans); font-weight: 600; color: var(--color-primary); margin-top: 1.25rem; }
    .services dd { margin: 0.3rem 0 0; color: var(--color-text); }
    .contact-card {
      margin-top: 1.5rem;
      padding: 1.4rem 1.6rem;
      border: 1px solid var(--color-rule);
      border-left: 4px solid var(--color-primary);
      border-radius: 2px;
      background: var(--color-bg-subtle);
      font-size: 0.98rem;
    }
    .contact-card p { margin-bottom: 0.5rem; }
    .contact-card p:last-child { margin-bottom: 0; }
    .contact-label {
      display: inline-block;
      min-width: 4.5rem;
      font-size: 0.8rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--color-text-meta);
    }
  </style>

  <h1>Consulting</h1>

  <p class="separation">
    <strong>Separation statement.</strong> The Corrections Pest Reference is maintained
    independently of the consulting practice described on this page. Engagement with the
    practice is not required to use the reference, and the reference does not change based
    on who is or is not a client.
  </p>

  <p>
    The author of this reference, Trenton S. Frazer, Board Certified Entomologist
    (BCE #B3413), maintains a professional consulting practice,
    <a href={CONSULTING_PRACTICE_URL}>{practice}</a>. Through that practice he can be
    retained by counties, sheriffs' offices, departments of corrections, detention
    operators, and their counsel for the work described below. The practice is national
    in scope. Engagements are fee-based.
  </p>

  <p>
    The BCE credential is held by Mr. Frazer personally and is issued by the Entomological
    Society of America Certification Corporation. It can be verified on the
    <a href="https://entocert.org/roster" target="_blank" rel="noopener">ESACC roster</a>.
  </p>

  <h2>What a Board Certified Entomologist Can Be Retained to Do</h2>

  <dl class="services">
    <dt>Facility pest program assessment</dt>
    <dd>
      An entomological assessment of a facility's kitchens, housing units, intake,
      commissary, warehouse, and perimeter, and of its current pest program, against the
      authorities that apply to it.
    </dd>

    <dt>Contract and scope review</dt>
    <dd>
      Independent review of an existing pest control agreement or solicitation: scope,
      service frequency, records, term, renewal, and cancellation, ahead of the facility's
      next decision point.
    </dd>

    <dt>Entomologist of Record engagement</dt>
    <dd>
      An ongoing arrangement under which a named Board Certified Entomologist is
      responsible for the entomological basis of the facility's pest program and available
      to its facility, food service, and health services leadership.
    </dd>

    <dt>Expert witness work</dt>
    <dd>
      Case review, opinion, and testimony in matters involving pest conditions in
      correctional and detention facilities, for counsel on either side.
    </dd>
  </dl>

  <h2>Contact</h2>

  <p>
    All inquiries about the practice, and all questions and corrections about the
    reference, use the contact route below. Fees are discussed on inquiry; no schedule is
    published here.
  </p>

  <div class="contact-card">
    <p><span class="contact-label">Email</span> <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a></p>
    <p><span class="contact-label">Phone</span> <a href={`tel:${CONTACT_PHONE_TEL}`}>{CONTACT_PHONE}</a></p>
    <p><span class="contact-label">Practice</span> <a href={CONSULTING_PRACTICE_URL}>frazerappliedentomology.com</a></p>
  </div>
</BaseLayout>
