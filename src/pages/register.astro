---
import BaseLayout from '../layouts/BaseLayout.astro';
import UpdateRegisterForm from '../components/UpdateRegisterForm.astro';
import { SITE_URL } from '../lib/site';
---

<BaseLayout
  title="Regulatory Update Register"
  description="Subscribe to receive a notice when a regulatory authority covered by the Healthcare Pest Reference changes: the change, its effective date, and the documentation it affects. Email only. Used for reference updates and nothing else."
  breadcrumbs={[{ name: 'Regulatory Update Register', url: `${SITE_URL}/register/` }]}
  hideFooterRegister
>
  <h1>Regulatory Update Register</h1>

  <p>
    The authorities on this reference are living documents. When one of them
    changes, the change is recorded on its authority page and a notice goes to
    the register. Each notice states what changed, the effective date, and the
    documentation a facility should expect to update in response.
  </p>

  <p>
    Nothing on this site is gated on subscription. The register exists so that
    the people who rely on the reference do not have to re-check it themselves.
  </p>

  <UpdateRegisterForm variant="page" idSuffix="page" />

  <h2>What the register is and is not</h2>

  <ul>
    <li>It sends notices of changes to authorities covered on this reference. Nothing else.</li>
    <li>It collects an email address only. No name, organization, or phone number is asked for or stored.</li>
    <li>Addresses are not shared, sold, or used for any commercial purpose.</li>
    <li>Every notice carries an unsubscribe link. You can also <a href="/unsubscribe/">unsubscribe here</a>.</li>
  </ul>

  <script>
    // Without JavaScript the subscribe endpoint redirects here with ?status=…;
    // surface it in the form's status line.
    const messages: Record<string, string> = {
      subscribed: 'Subscribed. You will receive a notice when an authority on this reference changes.',
      invalid: 'That does not look like a valid email address. Please check it and try again.',
      unavailable: 'The register is not accepting subscriptions right now. Please try again later.',
      error: 'Something went wrong. Please try again later.'
    };
    const key = new URLSearchParams(window.location.search).get('status');
    const status = document.querySelector<HTMLElement>('#register-form-page [data-register-status]');
    if (key && status && messages[key]) {
      status.textContent = messages[key];
      status.dataset.state = key === 'subscribed' ? 'ok' : 'error';
    }
  </script>
</BaseLayout>
