---
/**
 * Renders one schema.org JSON-LD block.
 *
 * Usage: <JsonLd data={organizationSchema()} />
 *
 * `</script>` inside a JSON string would end the script element early, so the
 * serialized output escapes `<` as \u003c. This is valid JSON and decodes
 * back to the same string.
 */
import type { Thing, WithContext } from 'schema-dts';

export interface Props {
  data: WithContext<Thing>;
}

const { data } = Astro.props;
const json = JSON.stringify(data, null, 0).replace(/</g, '\\u003c');
---

<script is:inline type="application/ld+json" set:html={json} />
