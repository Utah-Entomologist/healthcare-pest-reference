---
/**
 * Layout for /deficiencies/<slug>/ — one page per survey tag or Element of
 * Performance. The Markdown body supplies the eight required sections; this
 * layout supplies the source record, the content-pending notice, links to
 * governing authorities, the citation block, and the register form.
 */
import BaseLayout from './BaseLayout.astro';
import JsonLd from '../components/JsonLd.astro';
import CitationBlock from '../components/CitationBlock.astro';
import UpdateRegisterForm from '../components/UpdateRegisterForm.astro';
import RelatedAuthorities from '../components/RelatedAuthorities.astro';
import { articleSchema, personSchema } from '../lib/schema';
import { SITE_URL } from '../lib/site';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

export interface Props {
  entry: CollectionEntry<'deficiencies'>;
}

const { entry } = Astro.props;
const {
  identifier,
  title,
  seo_title,
  meta_description,
  regime,
  citation,
  source_url,
  source_tier,
  source_confidence,
  paywalled,
  content_pending,
  superseded_by,
  supersedes,
  last_verified,
  date_published,
  governing_authorities,
  related_deficiencies
} = entry.data;

const NOT_RECORDED = '[VERIFICATION DATE NOT RECORDED]';
const formatDate = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
const isoDate = (d?: Date) => (d ? d.toISOString().slice(0, 10) : undefined);

const permalink = `${SITE_URL}/deficiencies/${entry.slug}/`;
const fullTitle = `${identifier} — ${title}`;
const description = meta_description ?? `${identifier}, ${title}. What the tag enforces (${citation}), what surveyors look for, the documentation that satisfies it, and how to structure a plan of correction.`;

const all = await getCollection('deficiencies');
const bySlug = new Map<string, (typeof all)[number]>(all.map((d) => [d.slug, d]));
const related = related_deficiencies.map((slug) => {
  const target = bySlug.get(slug);
  if (!target) throw new Error(`Deficiency "${entry.slug}" references unknown deficiency slug "${slug}"`);
  return { slug, identifier: target.data.identifier, title: target.data.title };
});

const article = articleSchema({
  url: permalink,
  headline: fullTitle,
  description,
  datePublished: isoDate(date_published),
  dateModified: isoDate(last_verified),
  citation,
  citationUrl: source_url
});
---

<BaseLayout
  title={seo_title ?? fullTitle}
  description={description}
  canonical={permalink}
  ogType="article"
  breadcrumbs={[
    { name: 'Deficiencies', url: `${SITE_URL}/deficiencies/` },
    { name: fullTitle, url: permalink }
  ]}
>
  <Fragment slot="head">
    <JsonLd data={personSchema()} />
    <JsonLd data={article} />
  </Fragment>

  <p class="deficiency-kicker">{regime} · Survey deficiency reference</p>
  <h1><span class="deficiency-id">{identifier}</span> {title}</h1>

  {content_pending && (
    <p class="pending-notice">
      Parts of this page are awaiting primary-source text and are marked in the body.
      Nothing marked as pending has been paraphrased from secondary summaries.
    </p>
  )}

  <section class="authority-meta">
    <div class="authority-meta-header">Source Record</div>
    <dl>
      <dt>Issuing Regime</dt>
      <dd>{regime}</dd>

      <dt>Enforces</dt>
      <dd>{citation}</dd>

      <dt>Primary Source</dt>
      <dd><a href={source_url} target="_blank" rel="noopener">{source_url}</a></dd>

      <dt>Source Tier</dt>
      <dd>Tier {source_tier}</dd>

      <dt>Confidence</dt>
      <dd class={source_confidence === 'HIGH' ? 'confidence-high' : 'confidence-medium'}>{source_confidence}</dd>

      <dt>Paywalled</dt>
      <dd>{paywalled ? 'Yes — verbatim standard text requires institutional access' : 'No'}</dd>

      {supersedes && (
        <>
          <dt>Supersedes</dt>
          <dd>{supersedes}</dd>
        </>
      )}

      {superseded_by && (
        <>
          <dt>Superseded By</dt>
          <dd>{superseded_by}</dd>
        </>
      )}

      <dt>Last Verified</dt>
      <dd>{last_verified ? formatDate(last_verified) : NOT_RECORDED}</dd>
    </dl>

    <div class="verification-badge">
      <span>Maintained by <strong>Trenton L. Frazer, BCE #B3413</strong> · Board Certified Entomologist · <a href="/methodology/">verification methodology</a></span>
    </div>
  </section>

  <slot />

  <RelatedAuthorities entries={governing_authorities} heading="Governing Authorities" />

  {related.length > 0 && (
    <section class="related-deficiencies">
      <h2>Related Deficiency Pages</h2>
      <ul>
        {related.map((r) => (
          <li><a href={`/deficiencies/${r.slug}/`}><strong>{r.identifier}</strong> — {r.title}</a></li>
        ))}
      </ul>
    </section>
  )}

  <CitationBlock title={fullTitle} permalink={permalink} lastVerified={last_verified} />

  <UpdateRegisterForm variant="page" idSuffix="deficiency" />
</BaseLayout>

<style is:global>
  .deficiency-kicker {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text-meta);
    margin-bottom: 0.75rem;
  }

  .deficiency-id {
    display: block;
    font-family: 'SF Mono', Monaco, 'Cascadia Code', monospace;
    font-size: 1.1rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--color-accent);
    margin-bottom: 0.35rem;
  }

  .pending-notice {
    background: var(--color-bg-subtle);
    border-left: 3px solid var(--color-confidence-medium);
    padding: 0.9rem 1.2rem;
    font-size: 0.9rem;
    color: var(--color-text-muted);
    margin-bottom: 1.75rem;
  }

  .content-pending {
    display: inline-block;
    font-family: 'SF Mono', Monaco, 'Cascadia Code', monospace;
    font-size: 0.82rem;
    color: var(--color-warning);
    background: var(--color-bg-subtle);
    padding: 0.2em 0.5em;
    border: 1px dashed var(--color-warning);
    border-radius: 2px;
  }

  .related-deficiencies ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .related-deficiencies li {
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--color-rule);
  }

  .related-deficiencies li:last-child {
    border-bottom: none;
  }

  .related-deficiencies a {
    text-decoration: none;
    color: var(--color-primary);
  }

  .related-deficiencies a:hover {
    text-decoration: underline;
  }
</style>
