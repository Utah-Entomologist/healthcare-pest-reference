---
import BaseLayout from './BaseLayout.astro';
import JsonLd from '../components/JsonLd.astro';
import CitationBlock from '../components/CitationBlock.astro';
import UpdateRegisterForm from '../components/UpdateRegisterForm.astro';
import RelatedAuthorities from '../components/RelatedAuthorities.astro';
import { articleSchema, personSchema } from '../lib/schema';
import { SITE_URL } from '../lib/site';
import type { CollectionEntry } from 'astro:content';

export interface Props {
  authority: CollectionEntry<'authorities'>;
}

const { authority } = Astro.props;
const {
  title,
  seo_title,
  meta_description,
  related_authorities,
  authority_type,
  citation,
  last_verified,
  date_published,
  source_url,
  source_tier,
  source_confidence,
  paywalled,
  verbatim_available
} = authority.data;

const NOT_RECORDED = '[VERIFICATION DATE NOT RECORDED]';

const formatDate = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });

const lastVerifiedText = last_verified ? formatDate(last_verified) : NOT_RECORDED;
const isoDate = (d?: Date) => (d ? d.toISOString().slice(0, 10) : undefined);

const permalink = `${SITE_URL}/authorities/${authority.slug}/`;

const description =
  meta_description ??
  (last_verified
    ? `${title}. Source: ${citation}. Last verified ${lastVerifiedText}.`
    : `${title}. Source: ${citation}.`);

const isHub = authority.slug === 'cms-state-operations-manual';

const authorityTypeLabels: Record<string, string> = {
  'federal regulator': 'Federal Regulator',
  'state regulator': 'State Regulator',
  'accrediting body': 'Accrediting Body',
  'recognized authority': 'Recognized Authority'
};

const article = articleSchema({
  url: permalink,
  headline: title,
  description,
  datePublished: isoDate(date_published),
  dateModified: isoDate(last_verified),
  citation,
  citationUrl: source_url
});
---

<BaseLayout
  title={seo_title ?? title}
  description={description}
  canonical={permalink}
  ogType="article"
  breadcrumbs={[
    { name: 'Authorities', url: `${SITE_URL}/authorities/` },
    { name: title, url: permalink }
  ]}
>
  <Fragment slot="head">
    <JsonLd data={personSchema()} />
    <JsonLd data={article} />
  </Fragment>

  <h1>{title}</h1>

  <section class="authority-meta">
    <div class="authority-meta-header">Source Record</div>
    <dl>
      <dt>Authority Type</dt>
      <dd>{authorityTypeLabels[authority_type] || authority_type}</dd>

      <dt>Citation</dt>
      <dd>{citation}</dd>

      <dt>Primary Source</dt>
      <dd><a href={source_url} target="_blank" rel="noopener">{source_url}</a></dd>

      <dt>Source Tier</dt>
      <dd>Tier {source_tier}</dd>

      <dt>Confidence</dt>
      <dd class={source_confidence === 'HIGH' ? 'confidence-high' : 'confidence-medium'}>
        {source_confidence}
      </dd>

      <dt>Paywalled</dt>
      <dd>{paywalled ? 'Yes — institutional access recommended for litigation-grade use' : 'No'}</dd>

      <dt>Verbatim Available</dt>
      <dd>{verbatim_available ? 'Yes' : 'No — predecessor or paraphrase only'}</dd>

      <dt>Last Verified</dt>
      <dd>{lastVerifiedText}</dd>
    </dl>

    <div class="verification-badge">
      <span>Verified by <strong>Trenton L. Frazer, BCE #B3413</strong> · Board Certified Entomologist · <a href="/methodology/">verification methodology</a></span>
    </div>
  </section>

  <slot />

  <RelatedAuthorities
    entries={related_authorities}
    selfSlug={authority.slug}
    heading={isHub ? 'What to Read Next, in Order' : 'Related Authorities'}
    intro={isHub ? 'Most readers arrive at this page with a survey finding in hand. These are the pages a survey-response reader needs next, in the order they are usually needed.' : undefined}
  />

  <CitationBlock title={title} permalink={permalink} lastVerified={last_verified} />

  <UpdateRegisterForm variant="page" idSuffix="authority" />
</BaseLayout>
